        {
          "label": "反函数与值域",
          "steps": [
            "由 $y = \\dfrac{1}{x}$ 得 $x = \\dfrac{1}{y}$",
            "$\\dfrac{dx}{dy} = -\\dfrac{1}{y^2}$",
            "当 $x \\in [1,3]$ 时，$y \\in [\\dfrac{1}{3}, 1]$"
          ]
        },
        {
          "label": "概率密度函数",
          "steps": [
            "$f_X(x) = \\dfrac{1}{2}$，$x \\in [1,3]$",
            "$$f_Y(y) = f_X\\left(\\dfrac{1}{y}\\right) \\left|\\dfrac{dx}{dy}\\right| = \\dfrac{1}{2} \\cdot \\dfrac{1}{y^2}$$",
            "$$f_Y(y) = \\begin{cases} \\dfrac{1}{2y^2}, & y \\in [\\dfrac{1}{3}, 1] \\\\ 0, & \\text{其他} \\end{cases}$$"
