        "应用变量变换公式"
      ],
      "math_structure": {
        "type": "nonmonotonic_transformation",
        "template": "$Y = g(X)$，$g$ 非单调",
        "variable_count": 1
      },
      "difficulty": 3,
      "estimated_minutes": 12,
      "answer": [
        {
          "label": "值域与反函数",
          "steps": [
            "当 $X \\in [-2,2]$ 时，$Y = X^2 \\in [0, 4]$",
            "对每个 $y \\in (0,4)$，存在两个 $x$ 值：$x_1 = -\\sqrt{y}$，$x_2 = \\sqrt{y}$"
          ]
        },
        {
          "label": "概率密度函数",
          "steps": [
            "$f_X(x) = \\dfrac{1}{4}$，$x \\in [-2,2]$",
            "$\\dfrac{dx_1}{dy} = -\\dfrac{1}{2\\sqrt{y}}$，$\\dfrac{dx_2}{dy} = \\dfrac{1}{2\\sqrt{y}}$",
            "$$f_Y(y) = f_X(-\\sqrt{y})\\left|\\dfrac{-1}{2\\sqrt{y}}\\right| + f_X(\\sqrt{y})\\left|\\dfrac{1}{2\\sqrt{y}}\\right|$$",
            "$$= \\dfrac{1}{4} \\cdot \\dfrac{1}{2\\sqrt{y}} + \\dfrac{1}{4} \\cdot \\dfrac{1}{2\\sqrt{y}} = \\dfrac{1}{4\\sqrt{y}}$$",
            "$$f_Y(y) = \\begin{cases} \\dfrac{1}{4\\sqrt{y}}, & y \\in (0, 4) \\\\ 0, & \\text{其他} \\end{cases}$$"
          ]
        }
      ],
