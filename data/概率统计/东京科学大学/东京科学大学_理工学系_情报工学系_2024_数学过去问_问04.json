      ],
      "math_structure": {
        "type": "conditional_normal",
        "template": "标准化二维正态分布的条件分布",
        "variable_count": 2
      },
      "difficulty": 2,
      "estimated_minutes": 6,
      "answer": [
        {
          "label": "条件分布",
          "steps": [
            "条件期望：$E[V_1|V_2 = v_2] = \\rho v_2$",
            "条件方差：$\\text{Var}(V_1|V_2 = v_2) = 1 - \\rho^2$",
            "条件分布：$V_1|V_2 = v_2 \\sim N(\\rho v_2, 1-\\rho^2)$"
          ]
        }
      ],
      "id": "isct-2024-18d20a0bec-q04-practice-04",
