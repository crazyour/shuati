      "difficulty": 3,
      "estimated_minutes": 10,
      "answer": [
        {
          "label": "求通过了甲和乙的概率",
          "steps": [
            "设通过两个部门为事件$E$",
            "通过甲乙未通过丙：$P_1 = 0.8 \\times 0.7 \\times 0.1 = 0.056$",
            "通过甲丙未通过乙：$P_2 = 0.8 \\times 0.3 \\times 0.9 = 0.216$",
            "通过乙丙未通过甲：$P_3 = 0.2 \\times 0.7 \\times 0.9 = 0.126$",
            "$P(E) = 0.056 + 0.216 + 0.126 = 0.398$",
            "$P(\\text{甲乙}|E) = \\frac{P_1}{P(E)} = \\frac{0.056}{0.398} = \\frac{56}{398} = \\frac{28}{199}$"
          ]
        }
