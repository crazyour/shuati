  "subject": "工学府_土木工学専攻_問5",
  "text": "对概率密度函数 $f(x) = \\begin{cases} 2(1-x) & 0 \\leq x \\leq 1 \\\\ 0 & \\text{其他} \\end{cases}$ 给出的连续分布，求均值和方差。（8 分）",
  "knowledge_points": [
    "概率统计",
    "连续分布",
    "Beta 分布",
    "均值",
    "方差"
  ],
  "question_type": "连续型概率分布的均值与方差",
  "method": [
    "密度积分求均值",
    "密度积分求方差",
    "Beta 分布性质"
  ],
  "solution_steps": [
    "验证归一化",
    "计算 E[X]",
    "计算 E[X²]",
    "Var = E[X²] - E[X]²"
  ],
  "math_structure": {
    "type": "beta_distribution_moments",
    "template": "f(x)=2(1-x); E[X]=∫x·2(1-x)dx; Var[X]=∫x²·2(1-x)dx - E[X]²",
    "variable_count": 1
  },
  "difficulty": 1,
  "answer": [
    {
      "label": "均值和方差",
      "steps": [
        "$E[X] = \\int_0^1 2x(1-x) dx = 2 \\int_0^1 (x - x^2) dx = 2(1/2 - 1/3) = 2 \\cdot 1/6 = 1/3$。",
        "$E[X^2] = \\int_0^1 2x^2(1-x) dx = 2 \\int_0^1 (x^2 - x^3) dx = 2(1/3 - 1/4) = 2 \\cdot 1/12 = 1/6$。",
        "$\\text{Var}(X) = E[X^2] - E[X]^2 = 1/6 - 1/9 = 3/18 - 2/18 = 1/18$。"
      ]
    }
  ]
}
