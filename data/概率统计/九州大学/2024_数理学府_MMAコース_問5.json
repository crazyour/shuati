{
  "id": "2024_数理学府_MMAコース_問5",
  "school": "九州大学",
  "year": 2024,
  "subject": "数理学府_MMAコース_問5",
  "text": "设 $c$ 为正常数。实值随机变量 $X$ 的概率密度函数为\n$$f(x) = \\begin{cases} ce^{-2x} & (x \\geq 0) \\\\ 0 & (x < 0) \\end{cases}$$\n回答下列问题。\n\n(1) 求 $c$ 的值。\n\n(2) 求 $X$ 的期望和方差。\n\n(3) 设 $Y = \\lfloor X \\rfloor$（$X \\geq 0$）或 $Y = 0$（$X < 0$）。求 $Y$ 的期望。",
  "knowledge_points": [
    "概率统计",
    "指数分布",
    "Gamma 分布",
    "取整函数",
    "期望",
    "几何级数"
  ],
  "question_type": "指数分布的统计量与取整变换",
  "method": [
    "指数分布归一化",
    "Gamma 积分",
    "几何级数求和"
  ],
  "solution_steps": [
    "(1) c=2",
    "(2) E[X]=1/2, Var(X)=1/4",
    "(3) P(Y=k)=P(k≤X<k+1), E[Y]=Σ k P(Y=k)"
  ],
  "math_structure": {
    "type": "exponential_distribution_floor_transform",
    "template": "f=c e^(-λx); E[X]=1/λ; Var=1/λ²; E[floor(X)]=Σ k P(k≤X<k+1)",
    "variable_count": 2
  },
  "difficulty": 2,
  "answer": [
    {
      "label": "(1) c 值",
      "steps": [
        "$\\int_0^\\infty c e^{-2x} dx = c/2 = 1$，$c = 2$。"
      ]
    },
    {
      "label": "(2) E[X], Var[X]",
      "steps": [
        "$X \\sim \\text{Exp}(2)$，$E[X] = 1/2$，$\\text{Var}(X) = 1/4$。"
      ]
    },
    {
      "label": "(3) E[Y]",
      "steps": [
        "$Y = \\lfloor X \\rfloor$ 当 $X \\geq 0$。$P(Y = k) = P(k \\leq X < k+1) = \\int_k^{k+1} 2 e^{-2x} dx = e^{-2k} - e^{-2(k+1)} = e^{-2k}(1 - e^{-2})$，$k = 0,1,2,\\ldots$。",
        "$E[Y] = \\sum_{k=0}^\\infty k (1 - e^{-2}) e^{-2k}$",
        "$= (1 - e^{-2}) \\cdot \\frac{e^{-2}}{(1 - e^{-2})^2} = \\frac{e^{-2}}{1 - e^{-2}} = \\frac{1}{e^2 - 1}$。"
      ]
    }
  ]
}
