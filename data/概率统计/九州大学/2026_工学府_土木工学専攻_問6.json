{
  "id": "2026_工学府_土木工学専攻_問6",
  "school": "九州大学",
  "year": 2026,
  "subject": "工学府_土木工学専攻_問6",
  "text": "概率密度函数 $f(x) = \\begin{cases} a & 0.2 \\leq x \\leq 0.7 \\\\ 0 & \\text{其他} \\end{cases}$（$a$ 为常数）。回答下列问题。\n\n(1) 求正常数 $a$。\n\n(2) 求 $P(0.3 \\leq X \\leq 0.6)$。\n\n(3) 求均值 $\\mu$ 和方差 $\\sigma^2$（$\\sigma^2$ 保留 3 位有效数字）。\n\n(4) 设 $Y = 2X + 1$。求 $Y$ 的概率密度函数 $g(y)$。",
  "knowledge_points": [
    "概率统计",
    "均匀分布",
    "均值",
    "方差",
    "线性变换"
  ],
  "question_type": "区间均匀分布的统计量与线性变换",
  "method": [
    "均匀分布性质",
    "线性变换公式"
  ],
  "solution_steps": [
    "(1) ∫ f = 1",
    "(2) 区间长度 × 密度",
    "(3) E[X]=(a+b)/2, Var=(b-a)²/12",
    "(4) Y=aX+b 变换 g(y)=f((y-b)/a)/a"
  ],
  "math_structure": {
    "type": "uniform_distribution_linear_transform",
    "template": "f=1/(b-a); E=(a+b)/2; Var=(b-a)²/12; g(y)=f((y-b)/a)/a",
    "variable_count": 1
  },
  "difficulty": 2,
  "answer": [
    {
      "label": "(1) 求 $a$",
      "steps": [
        "$\\int_{0.2}^{0.7} a \\, dx = a \\cdot 0.5 = 1$，$a = 2$。"
      ]
    },
    {
      "label": "(2) 概率",
      "steps": [
        "$P(0.3 \\leq X \\leq 0.6) = (0.6 - 0.3) \\cdot 2 = 0.6$。"
      ]
    },
    {
      "label": "(3) 均值和方差",
      "steps": [
        "$X \\sim U(0.2, 0.7)$。",
        "$\\mu = (0.2 + 0.7)/2 = 0.45$。",
        "$\\sigma^2 = (0.7 - 0.2)^2/12 = 0.25/12 = 0.02083... \\approx 0.0208$（$3$ 位有效数字）。"
      ]
    },
    {
      "label": "(4) Y 的密度",
      "steps": [
        "$Y = 2X + 1$ 是单调变换。",
        "$X = (Y - 1)/2$，$|dX/dY| = 1/2$。",
        "$g(y) = f((y-1)/2) \\cdot 1/2 = 2 \\cdot 1/2 = 1$，$1.4 \\leq y \\leq 2.4$。",
        "其他 $y$ 时 $g(y) = 0$。"
      ]
    }
  ]
}
