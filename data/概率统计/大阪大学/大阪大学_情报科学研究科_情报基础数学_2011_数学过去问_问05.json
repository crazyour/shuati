        "用全概率公式求P(+)",
        "用贝叶斯公式求P(D|+)"
      ],
      "math_structure": {
        "type": "bayes_conditional_probability_basic",
        "template": "P(D)=p,P(+|D)=s,P(+|D^c)=1-sp（特异度），求P(D|+)",
