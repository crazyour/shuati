      ],
      "math_structure": {
        "type": "bayes_conditional_probability",
        "template": "P(D|+)=p(1-q)/[p(1-q)+(1-p)q]",
        "variable_count": 2
      },
      "difficulty": 2,
      "estimated_minutes": 7,
      "answer": [
        {
          "label": "结果",
          "steps": [
            "一般公式：$P(D\\mid+)=\\dfrac{p(1-q)}{p(1-q)+(1-p)q}$",
            "代入p=10^{-4},q=10^{-3}：分子$p(1-q)=10^{-4}\\times0.999=9.99\\times10^{-5}$，分母中(1-p)q=0.9999×10^{-3}=9.999\\times10^{-4}",
            "分母总和=9.99×10^{-5}+9.999×10^{-4}=1.0998×10^{-3}",
            "$P(D\\mid+)=\\dfrac{9.99\\times10^{-5}}{1.0998\\times10^{-3}}\\approx0.0909$，约为9.09%"
          ]
