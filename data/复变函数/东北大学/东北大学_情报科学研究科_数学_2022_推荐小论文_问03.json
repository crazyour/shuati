  "math_structure": {
    "type": "residue_theorem",
    "template": "若 $f(z)$ 在闭合曲线 $C$ 内部有有限个孤立奇点 $z_1, z_2, \\ldots, z_n$，则 $\\oint_C f(z)dz = 2\\pi i \\sum_{k=1}^n \\text{Res}(f, z_k)$",
