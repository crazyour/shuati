    "template": "$x=r\\cos\\theta,y=r\\sin\\theta$",
    "variable_count": 2
  },
  "difficulty": 3,
  "answer": [
    {
      "label": "证明",
      "steps": [
        "思路：采用坐标变换、链式法则，先写出各坐标变量的偏导。",
        "链式法则给出 $u_r=u_x\\cos\\theta+u_y\\sin\\theta$，$v_\\theta=-rv_x\\sin\\theta+rv_y\\cos\\theta$。",
        "代入 $u_x=v_y,u_y=-v_x$ 得 $u_r=v_\\theta/r$。",
        "同理可得 $v_r=-u_\\theta/r$。"
      ]
    }
  ],
