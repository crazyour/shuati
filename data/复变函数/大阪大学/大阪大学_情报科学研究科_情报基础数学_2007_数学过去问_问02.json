    "上半圆形围道"
  ],
  "solution_steps": [
    "求 $1+z^4=0$ 的根",
    "找上半平面极点",
    "计算留数",
    "应用留数定理"
  ],
  "math_structure": {
    "type": "residue_theorem_integral",
    "template": "$$\\int_0^\\infty \\frac{dx}{1+x^4} = \\frac{1}{2}\\int_{-\\infty}^\\infty \\frac{dx}{1+x^4}$$",
    "variable_count": 1
  },
  "difficulty": 4,
  "answer": [
    {
      "label": "用留数定理证明",
      "steps": [
        "极点为 $z_k = e^{i\\pi(2k+1)/4}, k=0,1,2,3$",
        "上半平面极点：$z_0=e^{i\\pi/4}, z_1=e^{i3\\pi/4}$",
        "留数：$\\text{Res}(f,z_j)=\\frac{1}{4z_j^3}$",
        "$e^{-i3\\pi/4}+e^{-i\\pi/4} = -i\\sqrt{2}$",
        "$\\int_{-\\infty}^\\infty \\frac{dx}{1+x^4} = 2\\pi i \\cdot \\frac{-i\\sqrt{2}}{4} = \\frac{\\pi\\sqrt{2}}{2}$",
        "由偶函数性：$\\int_0^\\infty \\frac{dx}{1+x^4} = \\frac{\\pi}{2\\sqrt{2}}$"
      ]
    }
  ],
