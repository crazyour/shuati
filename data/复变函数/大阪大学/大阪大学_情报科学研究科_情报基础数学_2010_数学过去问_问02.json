        "计算留数",
        "应用留数定理"
      ],
      "math_structure": {
        "type": "contour_integral_residue",
        "template": "\\int_{|z|=1}\\frac{dz}{az-1}",
        "variable_count": 1
      },
      "difficulty": 1,
      "estimated_minutes": 4,
      "answer": [
        {
          "label": "结果",
          "steps": [
