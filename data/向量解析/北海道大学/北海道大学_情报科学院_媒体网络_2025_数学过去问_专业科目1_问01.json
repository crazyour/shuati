      ],
      "question_type": "多部分计算",
      "method": [
        "偏导数",
        "多重积分"
      ],
      "solution_steps": [
        "逐项求偏导数",
        "计算曲面积分的被积函数",
        "分次积分"
      ],
      "math_structure": {
        "type": "polynomial_vector_integral",
        "template": "多项式向量场的散度与曲面积分",
        "variable_count": 3
      },
      "difficulty": 3,
      "estimated_minutes": 12,
      "answer": [
        {
          "label": "散度和曲面积分",
          "steps": [
            "计算散度：$\\frac{\\partial}{\\partial x}[x^3-2x] = 3x^2-2$，$\\frac{\\partial}{\\partial y}[y^3-2y] = 3y^2-2$，$\\frac{\\partial}{\\partial z}[2z] = 2$",
            "$f(x,y,z) = 3x^2-2+3y^2-2+2 = 3x^2+3y^2-2$",
            "曲面积分中 $\\mathbf{u} \\cdot \\mathbf{i} = x(x^2-2) = x^3-2x$",
            "$\\int_{0}^{1}\\int_{0}^{1} (x^3-2x) dx dy = \\int_{0}^{1} \\left[\\frac{x^4}{4}-x^2\\right]_{0}^{1} dy = \\int_{0}^{1} (\\frac{1}{4}-1) dy = \\int_{0}^{1} (-\\frac{3}{4}) dy = -\\frac{3}{4}$"
          ]
        }
