      ],
      "math_structure": {
        "type": "exponential_quadratic_extremum",
        "template": "求 $f(x,y) = e^{-x^2-y^2}(x^2 + y^2)$ 的极值",
        "variable_count": 2
      },
      "difficulty": 3,
      "estimated_minutes": 12,
      "answer": [
        {
          "label": "极值",
          "steps": [
            "$f_x = -2x e^{-x^2-y^2}(x^2+y^2) + 2x e^{-x^2-y^2} = 2x e^{-x^2-y^2}(1 - x^2 - y^2)$",
            "$f_y = 2y e^{-x^2-y^2}(1 - x^2 - y^2)$",
            "令 $f_x = f_y = 0$：当 $x = 0, y = 0$ 或 $x^2 + y^2 = 1$",
            "驻点为 $(0, 0)$ 和圆 $x^2 + y^2 = 1$ 上的所有点",
            "$f(0, 0) = 0$（极小值），$f(x, y) = e^{-1}$ 当 $x^2 + y^2 = 1$（极大值）"
          ]
        }
