      ],
      "math_structure": {
        "type": "parametric_integral_special_value",
        "template": "G(t)=\\int_0^\\infty\\frac{\\cos(tx)}{1+x^2}dx,\\ G(0)",
        "variable_count": 0
      },
      "difficulty": 1,
      "estimated_minutes": 3,
      "answer": [
        {
          "label": "计算",
          "steps": [
            "$G(0)=\\int_0^\\infty\\frac{1}{1+x^2}dx=[\\arctan x]_0^\\infty=\\frac{\\pi}{2}$",
            "结论：$G(0)=\\pi/2$"
          ]
        }
      ],
      "id": "isct-1998-ecc9f1f22d-q04-practice-02",
