          "面积",
          "三角函数"
        ],
        "question_type": "参数曲线面积",
        "method": [
          "参数面积公式"
        ],
        "solution_steps": [
          "求导数",
          "代入公式",
          "计算积分"
        ],
        "math_structure": {
          "type": "parametric_area",
          "template": "三角参数曲线的面积",
          "variable_count": 2
        },
        "difficulty": 2,
        "estimated_minutes": 6,
        "answer": [
          {
            "label": "面积",
            "steps": [
              "$x'(t) = -\\sin(t)$",
              "$A = \\int_0^\\pi \\sin^2(t) \\cdot (-\\sin(t)) dt = -\\int_0^\\pi \\sin^3(t) dt$",
              "由前面计算，$\\int_0^\\pi \\sin^3(t) dt = \\frac{4}{3}$",
              "但由于 $x$ 从 $1$ 递减到 $-1$，面积为 $\\int_0^\\pi \\sin^2(t) |\\sin(t)| dt = \\int_0^\\pi \\sin^3(t) dt = \\frac{4}{3}$"
            ]
          }
        ],
