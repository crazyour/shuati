      "text": "证明 $\\lim_{n \\to \\infty} \\sqrt[n]{n} = 1$。",
      "knowledge_points": [
        "极限的标准结论",
        "不等式放缩"
      ],
      "question_type": "证明题",
      "method": [
        "不等式论证",
        "极限定义"
      ],
      "solution_steps": [
        "用不等式估计",
        "应用夹逼定理"
      ],
      "math_structure": {
        "type": "nth_root_limit",
        "template": "$\\lim_{n \\to \\infty} \\sqrt[n]{n} = 1$",
        "variable_count": 0
      },
      "difficulty": 2,
      "estimated_minutes": 5,
      "answer": [
        {
          "label": "证明",
          "steps": [
            "令 $a_n = \\sqrt[n]{n}$，则 $a_n > 1$",
            "可设 $a_n = 1 + b_n$，其中 $b_n > 0$",
            "由二项式定理：$n = (1 + b_n)^n \\geq 1 + n b_n$，得 $b_n \\leq \\frac{n-1}{n}$",
            "因此 $0 < b_n \\leq \\frac{n-1}{n} \\to 0$，所以 $a_n \\to 1$"
          ]
        }
      ],
