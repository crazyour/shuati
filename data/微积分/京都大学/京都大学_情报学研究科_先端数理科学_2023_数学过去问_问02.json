    },
    {
      "text": "求幂级数 $\\sum_{n=1}^{\\infty} n x^n$ 的收敛半径。",
      "knowledge_points": [
        "Cauchy-Hadamard公式",
        "幂级数收敛半径"
      ],
      "question_type": "级数收敛性",
      "method": [
        "Cauchy公式",
        "比值法"
      ],
      "solution_steps": [
        "应用Cauchy-Hadamard或比值法",
        "计算极限"
      ],
      "math_structure": {
        "type": "power_series_convergence",
        "template": "$R = 1 / \\limsup |a_n|^{1/n}$",
        "variable_count": 1
      },
      "difficulty": 2,
      "estimated_minutes": 4,
      "answer": [
        {
          "label": "收敛半径",
          "steps": [
            "系数 $a_n = n$",
            "用比值法：$\\lim_{n \\to \\infty} |\\frac{a_{n+1}}{a_n}| = \\lim_{n \\to \\infty} \\frac{n+1}{n} = 1$",
            "因此 $R = 1$"
          ]
        }
      ],
