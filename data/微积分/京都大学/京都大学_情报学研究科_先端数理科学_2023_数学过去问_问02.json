  "subject": "情报学研究科_先端数理科学",
  "text": "给定正数 $x, y$，求证 $\\lim_{n \\to \\infty} (x^n + y^n)^{1/n} = \\max\\{x, y\\}$。其次，求幂级数 $\\sum_{n=0}^{\\infty}(2^n + 3^n)x^{2n}$ 的收敛半径。",
  "knowledge_points": [
    "极限的定义与计算",
    "幂级数收敛半径",
    "Cauchy-Hadamard公式",
    "极限的不等式处理"
  ],
  "question_type": "多部分极限与级数问题",
  "method": [
    "不等式放缩",
    "Cauchy-Hadamard定理",
    "级数收敛判别法"
  ],
  "solution_steps": [
    "分离max{x,y}进行极限分析",
    "通过不等式夹逼",
    "计算级数一般项系数",
    "应用Cauchy-Hadamard公式"
  ],
  "math_structure": {
    "type": "power_series_convergence",
    "template": "$\\sum_{n=0}^{\\infty} a_n x^n$ 的收敛半径 $R = \\frac{1}{\\limsup_{n \\to \\infty} |a_n|^{1/n}}$",
    "variable_count": 2
  },
  "difficulty": 3,
  "answer": [
    {
      "label": "(1) 极限证明",
      "steps": [
        "不失一般性设 $x \\leq y$，则 $\\max\\{x, y\\} = y$",
        "有 $y \\leq (x^n + y^n)^{1/n} \\leq (2y^n)^{1/n} = 2^{1/n} \\cdot y$",
        "当 $n \\to \\infty$ 时，$2^{1/n} \\to 1$",
        "由夹逼定理：$\\lim_{n \\to \\infty} (x^n + y^n)^{1/n} = y = \\max\\{x, y\\}$"
      ]
    },
    {
      "label": "(2) 收敛半径",
      "steps": [
        "级数为 $\\sum_{n=0}^{\\infty}(2^n + 3^n)x^{2n}$",
        "令 $u = x^2$，则级数化为 $\\sum_{n=0}^{\\infty}(2^n + 3^n)u^n$",
        "一般项系数 $a_n = 2^n + 3^n$",
        "计算：$\\limsup_{n \\to \\infty} |a_n|^{1/n} = \\limsup_{n \\to \\infty} (2^n + 3^n)^{1/n} = \\limsup_{n \\to \\infty} 3 \\cdot (\\frac{2^n}{3^n} + 1)^{1/n} = 3$",
        "关于 $u$ 的收敛半径为 $R_u = \\frac{1}{3}$",
        "因此关于 $x$ 的收敛半径为 $R_x = \\sqrt{\\frac{1}{3}} = \\frac{1}{\\sqrt{3}}$"
      ]
    }
  ],
  "practice_questions": [
    {
      "text": "求极限 $\\lim_{n \\to \\infty} (a^n + b^n)^{1/n}$，其中 $a, b > 0$。",
      "knowledge_points": [
        "极限计算",
        "数列极限"
      ],
      "question_type": "极限计算",
      "method": [
        "不等式夹逼",
        "极限性质"
      ],
      "solution_steps": [
        "分离最大值",
        "建立不等式",
        "应用夹逼定理"
      ],
      "math_structure": {
        "type": "limit_of_sum_powers",
        "template": "$\\lim_{n \\to \\infty} (a^n + b^n)^{1/n} = \\max\\{a, b\\}$",
        "variable_count": 2
      },
      "difficulty": 2,
      "estimated_minutes": 5,
      "answer": [
        {
          "label": "极限值",
          "steps": [
            "不失一般性设 $a \\geq b$",
            "有 $a \\leq (a^n + b^n)^{1/n} \\leq (2a^n)^{1/n} = 2^{1/n} a$",
            "当 $n \\to \\infty$ 时，$2^{1/n} \\to 1$，由夹逼定理得极限为 $a = \\max\\{a,b\\}$"
          ]
        }
      ],
      "id": "kyoto-2023-fc0b120ced-q02-practice-01",
