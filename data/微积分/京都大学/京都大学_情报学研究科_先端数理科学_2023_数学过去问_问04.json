        "计算积分"
      ],
      "math_structure": {
        "type": "double_integral_disk",
        "template": "$\\iint_D f(x,y) dA$ 其中D是圆盘",
        "variable_count": 3
      },
      "difficulty": 2,
      "estimated_minutes": 8,
      "answer": [
        {
          "label": "积分值",
          "steps": [
            "令u = x-1, v = y-1，则圆盘变为u²+v²≤1，圆心在原点",
            "$\\iint_D (x+y) dA = \\iint_{u²+v²≤1} (u+1+v+1) du dv$",
            "$= \\iint (u+v) du dv + 2\\iint du dv$",
            "第一项由对称性为0，第二项为 $2 \\cdot \\pi \\cdot 1^2 = 2\\pi$",
            "总值为 $2\\pi$"
          ]
        }
      ],
