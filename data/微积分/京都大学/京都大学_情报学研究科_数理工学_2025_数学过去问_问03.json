      },
      "difficulty": 3,
      "estimated_minutes": 8,
      "answer": [
        {
          "label": "结果",
          "steps": [
            "$2=4\\lambda x,1=6\\lambda y\\Rightarrow x=1/(2\\lambda),y=1/(6\\lambda)$",
