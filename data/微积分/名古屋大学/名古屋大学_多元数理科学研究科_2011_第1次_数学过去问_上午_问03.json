      "text": "求积分 $\\displaystyle\\int_0^1\\dfrac{t}{(t+2)(t+1)}dt$。",
      "knowledge_points": [
        "部分分式分解",
        "定积分计算"
      ],
      "question_type": "定积分计算题",
      "method": [
