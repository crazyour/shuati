      ],
      "math_structure": {
        "type": "symmetric_matrix_diagonalization",
        "template": "$B=\\begin{pmatrix}3&1\\\\1&3\\end{pmatrix}$，求正交对角化",
        "variable_count": 0
      },
      "difficulty": 1,
      "estimated_minutes": 6,
      "answer": [
        {
          "label": "求解",
          "steps": [
