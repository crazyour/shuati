      "answer": [
        {
          "label": "逐次积分",
          "steps": [
            "对 $\\frac{d^2y}{dx^2}=e^x$ 积分一次：",
            "$\\frac{dy}{dx}=e^x+C_1$",
            "再积分一次：",
            "$y=e^x+C_1 x+C_2$",
            "**通解**：$y=e^x+C_1 x+C_2$"
          ]
        }
