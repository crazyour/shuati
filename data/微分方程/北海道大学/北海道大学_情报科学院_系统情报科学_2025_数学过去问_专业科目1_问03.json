        "variable_count": 1
      },
      "difficulty": 2,
      "estimated_minutes": 10,
      "answer": [
        {
          "label": "初值问题求解",
          "steps": [
            "第一次积分：$\\frac{dy}{dx}=3x^2+C_1$",
            "由初值 $y'(0)=1$：$1=0+C_1 \\Rightarrow C_1=1$",
            "所以 $\\frac{dy}{dx}=3x^2+1$",
            "第二次积分：$y=x^3+x+C_2$",
            "由初值 $y(0)=0$：$0=0+0+C_2 \\Rightarrow C_2=0$",
            "**特解**：$y=x^3+x$"
          ]
        }
