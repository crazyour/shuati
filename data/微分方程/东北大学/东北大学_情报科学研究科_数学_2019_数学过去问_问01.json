      "math_structure": {
        "type": "trig_nonhomogeneous",
        "template": "$y'' + y = \\sin x$",
        "variable_count": 1
      },
      "difficulty": 2,
      "estimated_minutes": 7,
      "answer": [
        {
          "label": "通解",
          "steps": [
            "齐次：$y_h = C_1 \\cos x + C_2 \\sin x$",
            "特解：$i$ 是特征根，形式 $y_p = x(A\\sin x + B\\cos x)$",
            "代入得 $A = -1/2, B = 0$",
            "$y = C_1 \\cos x + C_2 \\sin x - \\frac{x}{2}\\cos x$"
          ]
        }
