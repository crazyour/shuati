        "写出通解"
      ],
      "math_structure": {
        "type": "constant_coefficient_ode",
        "template": "x''-5x'+6x=0",
        "variable_count": 0
      },
      "difficulty": 1,
      "estimated_minutes": 3,
      "answer": [
        {
          "label": "结果",
          "steps": [
            "特征方程 $r^2-5r+6=0\\Rightarrow(r-2)(r-3)=0$，根 $r=2,3$",
            "一般解：$x(t)=C_1e^{2t}+C_2e^{3t}$"
          ]
        }
      ],
