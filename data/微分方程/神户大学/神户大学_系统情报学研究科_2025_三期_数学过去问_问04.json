      "math_structure": {
        "type": "euler_homogeneous",
        "template": "$x^2y'' - 3xy' + 4y = 0$（齐次欧拉方程）",
        "variable_count": 0
      },
      "difficulty": 2,
      "estimated_minutes": 8,
      "answer": [
        {
          "label": "通解",
          "steps": [
            "设 $y = x^m$，则 $y' = mx^{m-1}$，$y'' = m(m-1)x^{m-2}$",
            "代入：$m(m-1)x^m - 3mx^m + 4x^m = 0$",
            "$m^2 - m - 3m + 4 = 0$",
            "$m^2 - 4m + 4 = 0$",
            "$(m-2)^2 = 0$，重根 $m = 2$",
            "通解为 $y = (C_1 + C_2 \\ln x)x^2$"
          ]
