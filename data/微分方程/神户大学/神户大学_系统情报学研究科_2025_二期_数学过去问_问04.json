      "answer": [
        {
          "label": "完整解答",
          "steps": [
            "分离变量：$\\frac{du}{u} = -4dx$",
            "两边积分：$\\ln|u| = -4x + C_0$",
            "通解：$u(x) = Ce^{-4x}$",
            "应用初值条件 $u(0) = 3$：",
            "$$3 = Ce^{0} = C$$",
            "所以 $C = 3$",
            "特解：$$u(x) = 3e^{-4x}$$"
