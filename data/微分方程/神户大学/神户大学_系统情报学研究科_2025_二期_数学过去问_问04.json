      "math_structure": {
        "type": "first_order_linear_homogeneous",
        "template": "$\\frac{du}{dx} + au = 0$ 的通解",
        "variable_count": 1
      },
      "difficulty": 1,
      "estimated_minutes": 5,
      "answer": [
        {
          "label": "完整解答",
          "steps": [
            "分离变量：$\\frac{du}{u} = -2dx$",
            "两边积分：$\\int \\frac{du}{u} = \\int -2dx$",
            "$$\\ln|u| = -2x + C_0$$",
            "$$|u| = e^{-2x + C_0} = e^{C_0} \\cdot e^{-2x}$$",
            "设 $C = \\pm e^{C_0}$，则通解为：",
            "$$u(x) = Ce^{-2x}$$"
          ]
        }
      ],
