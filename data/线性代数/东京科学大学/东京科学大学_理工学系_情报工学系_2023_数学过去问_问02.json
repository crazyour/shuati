        "令梯度为零：$Qx + c = 0$",
        "求解"
      ],
      "math_structure": {
        "type": "critical_point",
        "template": "$\\nabla h = Qx + c = 0$",
        "variable_count": 2
      },
      "difficulty": 1,
      "estimated_minutes": 5,
      "answer": [
        {
          "label": "求临界点",
          "steps": [
            "$\\begin{pmatrix} 1 & 0 \\\\ 0 & 2 \\end{pmatrix} \\begin{pmatrix} x_1 \\\\ x_2 \\end{pmatrix} + \\begin{pmatrix} 3 \\\\ 1 \\end{pmatrix} = \\begin{pmatrix} 0 \\\\ 0 \\end{pmatrix}$",
            "$x_1 + 3 = 0 \\Rightarrow x_1 = -3$",
            "$2x_2 + 1 = 0 \\Rightarrow x_2 = -\\frac{1}{2}$",
            "临界点：$\\begin{pmatrix} -3 \\\\ -\\frac{1}{2} \\end{pmatrix}$"
          ]
        }
