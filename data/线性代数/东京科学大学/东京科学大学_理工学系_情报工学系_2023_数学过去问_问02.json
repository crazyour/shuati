        "检验条件"
      ],
      "math_structure": {
        "type": "positive_definite",
        "template": "判定对称矩阵Q是否正定",
        "variable_count": 0
      },
      "difficulty": 2,
      "estimated_minutes": 8,
      "answer": [
        {
          "label": "判定正定性",
          "steps": [
            "$\\det Q = 3 \\cdot 2 - 1 \\cdot 1 = 6 - 1 = 5 > 0$",
            "主对角元 $3 > 0$，$2 > 0$",
            "$\\det Q > 0$ 且对角元都为正，Q为正定矩阵"
          ]
        }
      ],
