    {
      "text": "设 $h(x_1, x_2) = x_1^2 + 2x_1 x_2 + 3x_2^2 - 6x_1 - 2x_2 + 5$。求满足 $\\nabla h = 0$ 的点，并判定该点是否为极小值点。",
      "knowledge_points": [
        "梯度与Hessian矩阵",
        "极值判定"
      ],
      "question_type": "极值判定",
      "method": [
        "求梯度并令其为零",
        "计算Hessian矩阵"
      ],
      "solution_steps": [
        "求偏导数",
        "令梯度为零求临界点",
        "计算Hessian矩阵",
        "判定正定性"
      ],
      "math_structure": {
        "type": "extremum_test",
        "template": "判定二元函数的极值点",
        "variable_count": 2
      },
      "difficulty": 3,
      "estimated_minutes": 12,
      "answer": [
        {
          "label": "求梯度",
          "steps": [
            "$\\dfrac{\\partial h}{\\partial x_1} = 2x_1 + 2x_2 - 6$",
            "$\\dfrac{\\partial h}{\\partial x_2} = 2x_1 + 6x_2 - 2$"
          ]
        },
        {
          "label": "求临界点",
          "steps": [
            "$2x_1 + 2x_2 = 6$",
            "$2x_1 + 6x_2 = 2$",
            "两式相减：$-4x_2 = 4 \\Rightarrow x_2 = -1$",
            "代入：$2x_1 - 2 = 6 \\Rightarrow x_1 = 4$",
            "临界点 $(4, -1)$"
          ]
        },
        {
          "label": "Hessian矩阵与极值判定",
          "steps": [
            "Hessian矩阵 $H = \\begin{pmatrix} 2 & 2 \\\\ 2 & 6 \\end{pmatrix}$",
            "$\\det H = 2 \\cdot 6 - 2 \\cdot 2 = 12 - 4 = 8 > 0$",
            "$H$ 的左上角元素 $2 > 0$",
            "H 正定，故 $(4, -1)$ 为极小值点"
          ]
        }
      ],
