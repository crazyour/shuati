    "求特征值和特征向量",
    "对角化矩阵求B^n极限",
    "利用初始向量求数列极限"
  ],
  "solution_steps": [
    "由递推关系写出矩阵B",
    "求解特征方程得到特征值",
    "对每个特征值求特征向量",
    "将B对角化为B=PDP^{-1}",
    "利用|λ|<1的特征值趋于0求B^n的极限",
    "用初始向量与极限矩阵得到a_k的极限"
