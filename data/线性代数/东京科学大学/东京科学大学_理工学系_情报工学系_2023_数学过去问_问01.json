    {
      "text": "设含参矩阵 $A = \\begin{pmatrix} 1 & 0 & 0 \\\\ 0 & m & 1 \\\\ 0 & 2 & m+1 \\end{pmatrix}$，$B = \\begin{pmatrix} n & 0 & 1 \\\\ 0 & 2 & 2 \\\\ 0 & 3 & 1 \\end{pmatrix}$。当 $m \\neq 0$、$n \\neq 0$ 时，用 $m, n$ 表示 $|AB^{-1}|$。",
      "knowledge_points": [
        "含多参行列式",
        "展开定理"
      ],
      "question_type": "多参行列式",
      "method": [
        "按含零列展开"
      ],
      "solution_steps": [
        "按第1列展开以化简 $|A|$",
        "按第1列展开以化简 $|B|$",
        "求比值"
      ],
      "math_structure": {
        "type": "multiparameter_determinant",
        "template": "$|AB^{-1}| = \\frac{|A|}{|B|}$，含多个参数",
        "variable_count": 2
      },
      "difficulty": 3,
      "estimated_minutes": 12,
      "answer": [
        {
          "label": "计算|A|",
          "steps": [
            "按第1列展开：$|A| = 1 \\cdot \\begin{vmatrix} m & 1 \\\\ 2 & m+1 \\end{vmatrix}$",
            "$= m(m+1) - 2 = m^2 + m - 2$"
          ]
        },
        {
          "label": "计算|B|",
          "steps": [
            "按第1列展开：$|B| = n \\begin{vmatrix} 2 & 2 \\\\ 3 & 1 \\end{vmatrix}$",
            "$= n(2 - 6) = -4n$"
          ]
        },
        {
          "label": "结果",
          "steps": [
            "$|AB^{-1}| = \\frac{m^2 + m - 2}{-4n} = \\frac{(m+2)(m-1)}{-4n} = -\\frac{(m+2)(m-1)}{4n}$"
          ]
        }
      ],
      "id": "isct-2023-b0410e4e07-q01-practice-04",
      "school": "东京科学大学",
      "year": "2023"
    }
  ],
