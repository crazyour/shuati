        "行列式展开"
      ],
      "solution_steps": [
        "计算 $|A|$",
        "用参数 $p$ 表示 $|B|$",
        "由等式 $\\frac{|A|}{|B|} = \\frac{3}{2}$ 求 $p$"
      ],
      "math_structure": {
        "type": "parametric_determinant",
        "template": "$\\frac{|A|}{|B|} = k$，求参数",
        "variable_count": 1
      },
      "difficulty": 3,
      "estimated_minutes": 10,
      "answer": [
        {
          "label": "计算|A|",
          "steps": [
            "$|A| = 3 \\begin{vmatrix} 2 & 1 \\\\ 4 & 3 \\end{vmatrix} = 3(6-4) = 6$"
          ]
        },
        {
          "label": "计算|B|",
          "steps": [
            "$|B| = p \\begin{vmatrix} 2 & 3 \\\\ 5 & 1 \\end{vmatrix} = p(2-15) = -13p$"
          ]
        },
        {
          "label": "求参数p",
          "steps": [
            "$\\frac{6}{-13p} = \\frac{3}{2}$",
            "$-13p = 4$",
            "$p = -\\frac{4}{13}$"
          ]
        }
      ],
      "id": "isct-2023-b0410e4e07-q01-practice-03",
