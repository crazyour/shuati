        "求比值"
      ],
      "math_structure": {
        "type": "determinant_ratio_3x3",
        "template": "$|AB^{-1}| = \\frac{|A|}{|B|}$",
        "variable_count": 0
      },
      "difficulty": 2,
      "estimated_minutes": 8,
      "answer": [
        {
          "label": "计算|A|",
          "steps": [
            "$|A| = 2 \\begin{vmatrix} 3 & 2 \\\\ 1 & 5 \\end{vmatrix} = 2(15-2) = 26$"
          ]
        },
        {
          "label": "计算|B|",
          "steps": [
            "$|B| = 1 \\cdot \\begin{vmatrix} 3 & 4 \\\\ 1 & 2 \\end{vmatrix} = 1(6-4) = 2$"
          ]
        },
        {
          "label": "结果",
          "steps": [
            "$|AB^{-1}| = \\frac{26}{2} = 13$"
          ]
