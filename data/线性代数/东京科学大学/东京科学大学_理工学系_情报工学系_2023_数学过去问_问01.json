  "subject": "理工学系_情报工学系",
  "text": "计算以下矩阵乘积的行列式。设\n$$A = \\begin{pmatrix} 2 & 0 & 0 \\\\ 13 & 5 & a \\\\ 25 & 8 & b \\end{pmatrix}, \\quad B = \\begin{pmatrix} c & 3 & 4 \\\\ 0 & 9 & 27 \\\\ 0 & 24 & 3d \\end{pmatrix}$$\n其中 $c \\neq 0$ 且 $c \\neq 24$。计算 $P = AB^{-1}$ 的行列式 $|P|$。",
  "knowledge_points": [
    "行列式的计算方法",
    "矩阵乘积的行列式",
    "矩阵逆的行列式"
  ],
  "question_type": "行列式计算",
  "method": [
    "行列式展开定理",
    "利用 $|AB^{-1}| = \\frac{|A|}{|B|}$"
  ],
  "solution_steps": [
    "按第一行对矩阵A进行行列式展开",
    "按第一列对矩阵B进行行列式展开",
    "应用矩阵乘积的行列式公式"
  ],
  "math_structure": {
    "type": "matrix_determinant_ratio",
    "template": "$|P| = \\frac{|A|}{|B|}$，其中 $A,B$ 为 $3 \\times 3$ 矩阵，B可逆",
    "variable_count": 4
  },
  "difficulty": 2,
  "answer": [
    {
      "label": "计算|A|",
      "steps": [
        "按第1行展开：$|A| = 2 \\begin{vmatrix} 5 & a \\\\ 8 & b \\end{vmatrix} - 0 + 0$",
        "$= 2(5b - 8a) = 10b - 16a$"
      ]
    },
    {
      "label": "计算|B|",
      "steps": [
        "按第1列展开：$|B| = c \\begin{vmatrix} 9 & 27 \\\\ 24 & 3d \\end{vmatrix}$",
        "$= c(9 \\cdot 3d - 27 \\cdot 24) = c(27d - 648)$",
        "$= 27c(d - 24)$"
      ]
    },
    {
      "label": "计算|P|",
      "steps": [
        "由 $|P| = |AB^{-1}| = \\frac{|A|}{|B|}$",
        "$|P| = \\dfrac{10b - 16a}{27c(d-24)} = \\dfrac{2(5b - 8a)}{27c(d-24)}$"
      ]
    }
  ],
