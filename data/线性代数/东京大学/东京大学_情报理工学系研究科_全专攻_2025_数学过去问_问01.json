  "answer": [
    {
      "label": "(1)",
      "steps": [
        "系数向量 $(v_1, v_2, -(v_1 a_1 + v_2 a_2))^T$"
      ]
    },
    {
      "label": "(2)",
      "steps": [
        "$$M = \\begin{pmatrix} 1-2n_1^2 & -2n_1 n_2 & -2n_1(\\vec{n}\\cdot\\vec{b}) \\\\ -2n_1 n_2 & 1-2n_2^2 & -2n_2(\\vec{n}\\cdot\\vec{b}) \\\\ 0 & 0 & 1 \\end{pmatrix}$$"
      ]
    },
    {
      "label": "(3)",
      "steps": [
        "$\\det(M) = -1$（镜像的行列式为负一）"
      ]
    },
    {
      "label": "(4)",
      "steps": [
        "固定点：$(-\\frac{1}{4}, 0)$"
      ]
    },
