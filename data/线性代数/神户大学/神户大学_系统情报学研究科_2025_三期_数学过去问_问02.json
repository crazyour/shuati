  "math_structure": {
    "type": "parametric_matrix_rank",
    "template": "$A = \\begin{pmatrix} 2a-1 & a & a-1 \\\\ a & 2a & a \\\\ a-1 & a & 2a-1 \\end{pmatrix}$，求 $\\det(A) = 0$ 和 $\\text{rank}(A)$",
    "variable_count": 1
