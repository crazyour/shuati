  ],
  "solution_steps": [
    "计算$T(1), T(x), T(x^2)$的坐标表示",
    "组成矩阵$A$",
    "计算$\\det(A - \\lambda I)$",
    "求解$\\lambda$"
  ],
  "math_structure": {
