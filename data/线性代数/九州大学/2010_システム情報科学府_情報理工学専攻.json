        "特征值",
        "特征向量"
      ],
      "question_type": "求二阶矩阵特征对",
      "method": [
        "特征多项式"
      ],
      "solution_steps": [
        "求特征多项式",
        "分别求特征空间"
      ],
      "math_structure": {
        "type": "matrix_eigenpair",
        "template": "$\\det(C-\\lambda I)=0$",
        "variable_count": 1
      },
      "difficulty": 1,
