      ],
      "solution_steps": [
        "保留原特征向量",
        "给每个特征值加二"
      ],
      "math_structure": {
        "type": "shifted_matrix_spectrum",
        "template": "$B=aI+C$",
        "variable_count": 1
      },
      "difficulty": 1,
      "estimated_minutes": 3,
      "answer": [
        {
          "label": "答案",
          "steps": [
            "先围绕标量矩阵、特征值平移采用特征值平移：保留原特征向量。",
            "若 $Cv=\\mu v$，则 $Bv=(2+\\mu)v$。",
            "所以 $B$ 的特征值为 $1,2,5$。"
          ]
        }
      ]
    },
