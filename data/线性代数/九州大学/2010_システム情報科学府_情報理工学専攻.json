    "最小多项式"
  ],
  "solution_steps": [
    "把矩阵分解为标量矩阵与固定矩阵之和",
    "求固定矩阵的三个特征值和特征向量",
    "利用谱分解或幂的递推关系计算矩阵幂"
  ],
  "math_structure": {
    "type": "symmetric_matrix_eigen_power",
    "template": "$A=xI+C$，$C^3=2C$",
