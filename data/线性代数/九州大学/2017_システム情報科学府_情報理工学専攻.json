    "核空间"
  ],
  "solution_steps": [
    "利用基表示唯一性定义坐标",
    "逐项比较和与数乘的系数",
    "把像空间中的线性关系拉回原空间"
  ],
  "math_structure": {
    "type": "coordinate_isomorphism",
    "template": "$f(\\sum_i\\alpha_iv_i)=(\\alpha_i)_i$",
    "variable_count": 3
