      "knowledge_points": [
        "行列式与线性相关性",
        "几何直观"
      ],
      "question_type": "概念辨析",
      "method": [
        "行列式为零的意义"
      ],
      "solution_steps": [
        "计算或引用已知行列式值",
        "解释几何意义"
      ],
      "math_structure": {
        "type": "determinant_zero_interpretation",
        "template": "\\det A=0 \\Rightarrow \\text{线性相关}",
        "variable_count": 0
