        "代入 A^n 公式取极限"
      ],
      "math_structure": {
        "type": "matrix_power_limit_application",
        "template": "\\lim A^n(4,2)^T,\\ \\lambda_1=1,\\lambda_2=0.5",
        "variable_count": 2
      },
      "difficulty": 2,
      "estimated_minutes": 6,
      "answer": [
        {
          "label": "结果",
          "steps": [
