      ],
      "math_structure": {
        "type": "matrix_power_basic",
        "template": "2×2矩阵满足λ²+1=0，求B^4",
        "variable_count": 0
      },
      "difficulty": 1,
      "estimated_minutes": 5,
      "answer": [
        {
          "label": "结果",
          "steps": [
