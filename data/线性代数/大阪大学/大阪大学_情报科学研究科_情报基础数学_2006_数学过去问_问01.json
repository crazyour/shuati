  ],
  "question_type": "矩阵特征值与二次型",
  "method": [
    "计算特征多项式与特征值",
    "二次型半正定性与特征值关系",
    "参数范围确定",
    "特征向量求解"
  ],
  "solution_steps": [
    "计算 $\\det(A-\\lambda E)$",
    "因式分解特征多项式",
    "由对称矩阵特征值判断二次型正定性",
    "确定参数 $a$ 的下界",
    "求 $aE-A$ 零特征值对应的特征向量"
