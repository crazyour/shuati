        "秩的判定"
      ],
      "solution_steps": [
        "计算行列式判断秩",
        "若行列式非零则秩为3"
      ],
      "math_structure": {
        "type": "determinant_rank_relationship",
        "template": "$\\det(Q) \\neq 0 \\Leftrightarrow \\text{rank}(Q) = n$",
        "variable_count": 1
      },
      "difficulty": 2,
      "estimated_minutes": 6,
      "answer": [
        {
          "label": "行列式与秩",
          "steps": [
            "按第一行展开：$\\det(Q) = 2(4-1) - 1(2-0) + 0 = 6 - 2 = 4 \\neq 0$",
            "因为 $\\det(Q) = 4 \\neq 0$，Q满秩，$\\text{rank}(Q) = 3$"
          ]
        }
      ],
