    {
      "text": "若 $3 \\times 3$ 矩阵 $P$ 满秩，证明：若 $PA = PB$，则 $A = B$。",
      "knowledge_points": [
        "满秩矩阵的性质",
        "矩阵可逆性",
        "矩阵乘法的消去律"
      ],
      "question_type": "证明题",
      "method": [
        "可逆矩阵理论",
        "零空间分析"
      ],
      "solution_steps": [
        "从PA=PB推导P(A-B)=0",
        "利用满秩性质"
      ],
      "math_structure": {
        "type": "invertible_matrix_cancellation",
        "template": "满秩矩阵 $P \\in \\mathbb{R}^{n \\times n}$ 满足 $PA = PB \\Rightarrow A = B$",
        "variable_count": 3
      },
      "difficulty": 2,
      "estimated_minutes": 5,
      "answer": [
        {
          "label": "证明",
          "steps": [
            "由 $PA = PB$ 得 $PA - PB = 0$",
            "即 $P(A - B) = 0$",
            "设 $C = A - B$，则 $PC = 0$",
            "P满秩意味着P可逆，两边左乘 $P^{-1}$：$C = 0$",
            "因此 $A = B$"
          ]
        }
      ],
