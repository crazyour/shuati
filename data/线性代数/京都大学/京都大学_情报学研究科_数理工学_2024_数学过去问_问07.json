    "特征值求解",
    "特征向量求解",
    "对角化条件"
  ],
  "question_type": "矩阵对角化",
  "method": [
    "计算特征多项式$\\det(A-\\lambda I)$",
    "求特征值",
    "对每个特征值求特征向量",
    "构造$P$"
  ],
  "solution_steps": [
    "展开行列式$\\det(A-\\lambda I)$",
    "求根得特征值",
    "逐一求特征向量",
    "组成矩阵$P$并验证"
  ],
  "math_structure": {
    "type": "matrix_diagonalization_3x3",
    "template": "A=\\begin{pmatrix}1&1&0\\\\2&1&2\\\\0&1&1\\end{pmatrix},\\ \\text{求}P\\text{使}P^{-1}AP=D",
    "variable_count": 0
