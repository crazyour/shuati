# 复制成 .env（.env 已在 .gitignore 里，不会被提交）
MINIMAX_API_KEY=your_minimax_api_key_here

# 下面三个不填就用 config/default.json 里的值，填了就覆盖
# MINIMAX_MODEL=MiniMax-M2.7
# MINIMAX_BASE_URL=https://agent.minimaxi.com/mavis/api/v1/llm/v1
# MINIMAX_API_STYLE=anthropic

# 公网域名（Vercel 部署后会给你 xxx.vercel.app，或你自己的域名）
# sitemap.xml / canonical URL 会用它；不填就从请求头推断
# SITE_BASE_URL=https://your-app.vercel.app

# ----------- 反馈问卷（右下浮动按钮） -----------
# FEEDBACK_ENABLED 设成 false 可以临时关闭：FAB 不渲染、/api/feedback 不注册。
# 不填默认开启。改回 true 重新打开。
# FEEDBACK_ENABLED=false

# 提交时会：
#   1) 保存到 Formcarry 后台（主存储）
#   2) 尽量追加到本地 data/feedback.jsonl（只作备份）
# 项目已内置当前的 Formcarry 地址；以后换表单时可在部署环境里覆盖：
# FORMCARRY_URL=https://formcarry.com/s/your-form-id
