# 复制成 .env（.env 已在 .gitignore 里，不会被提交）
MINIMAX_API_KEY=your_minimax_api_key_here

# 下面三个不填就用 config/default.json 里的值，填了就覆盖
# MINIMAX_MODEL=MiniMax-M2.7
# MINIMAX_BASE_URL=https://agent.minimaxi.com/mavis/api/v1/llm/v1
# MINIMAX_API_STYLE=anthropic

# ----------- 反馈问卷（右下浮动按钮） -----------
# FEEDBACK_ENABLED 设成 false 可以临时关闭：FAB 不渲染、/api/feedback 不注册。
# 不填默认开启。改回 true 重新打开。
# FEEDBACK_ENABLED=false

# 提交时会：
#   1) 追加到本地 data/feedback.jsonl（永远会写）
#   2) 转发一份到你的 Notion 数据库（NOTION_TOKEN 和 NOTION_DATABASE_ID 都填了才转发）
#
# Notion 那边要先建一个数据库，并把这些属性加好（名字必须一致）：
#   - 提交时间    (Date)
#   - 付费意愿    (Select,    选项：不愿付费 / 1-5元 / 5-15元 / 15-30元 / 30+元 / 其他)
#   - 当前身份    (Select,    选项：备考 / 工作 / 其他)
#   - 建议        (Rich text)
#   - 其他说明    (Rich text)        —— 仅当付费意愿 = "其他" 时才会填，否则留空
#   - 来源        (Select,    选项：webapp)
# 然后到 https://www.notion.so/profile/integrations 创建一个 internal integration，
# 把目标数据库「Add connections」给它，复制它的 Secret 填到 NOTION_TOKEN。
NOTION_TOKEN=
NOTION_DATABASE_ID=